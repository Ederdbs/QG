# Leading slashes matter: an unanchored `data/` would also swallow book/data,
# which the book must be able to read from a clean clone.
/report/
/data/
.Rhistory
.RData
.DS_Store
doc/diversity_metrics_files/libs/*
book/.quarto/

/.quarto/
**/*.quarto_ipynb

# Quarto intermediates left in book/ by the typst pass; the real figures
# live in book/_freeze and docs/.
book/*_files/
